/* Naam: S.F.L. Wagenaar
 * UvAnetID: 16409752
 * Studie: BSc Informatica
 *
 * Een simpele doolhof spel:
 * - roep aan met ./spel DOOLHOF_BESTAND
 * - een doolhof is rechthoekig en bestaat uit:
 *   - muren '#'
 *   - vallen 'X'
 *   - een speler '*'
 *   - een doel '$'
 * - gebruik WASD of de pijltoetsen om te bewegen
 */

// om `nanosleep` beschikbaar te maken
#define _POSIX_C_SOURCE 199309L

#include <assert.h>
#include <time.h>
#include <string.h>
#include <stdio.h>
#include <stdlib.h>

#include <ncurses.h>

#include "rooster.h"

#define C_ACHTERGROND 0
#define C_LEEG        1
#define C_MUUR        2
#define C_SPELER      3
#define C_DOEL        4
#define C_VAL         5
#define C_WIN         6
#define C_VERLIES     7
#define C_ROOD        8
#define C_GROEN       9

/* Vul het hele scherm met de achtergrondkleur
 */
void wis_scherm(void) {
    attron(COLOR_PAIR(C_ACHTERGROND));
    for (int y = 0; y < LINES; y++) {
        move(y, 0);
        for (int x = 0; x < COLS; x++) {
            addch(' ');
        }
    }
    attroff(COLOR_PAIR(C_ACHTERGROND));
}

/* Toont het gegeven rooster met ncurses.

   rp: een pointer naar het rooster.
*/
void toon_rooster(const rooster *rp) {
    int breedte = rooster_breedte(rp);
    int hoogte = rooster_hoogte(rp);

    for (int y = 0; y < hoogte; y++) {
        move(LINES / 2 - hoogte / 2 + y, COLS / 2 - breedte / 2);

        for (int x = 0; x < breedte; x++) {
            char c = rooster_kijk(rp, x, y);
            int type;
            switch (c) {
                case ' ': type = C_LEEG; break;
                case '#': type = C_MUUR; break;
                case '*': type = C_SPELER; break;
                case '$': type = C_DOEL; break;
                case 'X': type = C_VAL; break;
                default:  type = -1; break;
            }
            if (type != -1) {
                attron(COLOR_PAIR(type));
            }
            addch(c);
            if (type != -1) {
                attroff(COLOR_PAIR(type));
            }
        }
    }
}

/* Voert de benodigde veranderingen in het rooster door als de speler in een
   bepaalde richting probeert te bewegen.

   rp   : een pointer naar het rooster
   dx,dy: de richting waarin de speler probeert te bewegen. De vier mogelijk-
          heden voor (dx,dy) zijn (-1,0), (1,0), (0,-1), (0,1) voor resp.
          links, rechts, omhoog en omlaag.

   Side effect: het rooster wordt aangepast op basis van de handeling van
                de speler.
*/
void beweeg(rooster *rp, int dx, int dy) {
    int x;
    int y;
    rooster_zoek(rp, '*', &x, &y);
    if (x == -1 || y == -1) {
        return;
    }

    const int x0 = x;
    const int y0 = y;

    x += dx;
    y += dy;

    char c = rooster_kijk(rp, x, y);
    switch (c) {
        case ' ':
            rooster_plaats(rp, x0, y0, ' ');
            rooster_plaats(rp, x, y, '*');
            break;
        case '$':
            rooster_zet_toestand(rp, GEWONNEN);
            break;
        case 'X':
            rooster_zet_toestand(rp, VERLOREN);
            break;
        default:
            mvaddch(0, 0, c);
            break;
    }
}

/* Teken een doos
 *
 * (y0, x0): coördinaten van de linkerbovenhoek
 * (hoogte, breedte): maat van de doos
 * (boven_links, boven_rechts, onder_links, onder_rechts): karakters om de hoeken mee te tekenen
 * (boven, onder, links, rechts): karakters om de zijkanten mee te tekenen
 *
 * Side effect: een doos wordt getekend op het scherm
 */
void doos(
    int y0, int x0, int hoogte, int breedte,
    char boven_links, char boven_rechts, char onder_links, char onder_rechts,
    char boven, char onder, char links, char rechts
) {
    int y1 = y0 + hoogte;
    int x1 = x0 + breedte;

    mvaddch(y0, x0, boven_links);
    for (int x = x0 + 1; x < x1 - 1; x++) {
        addch(boven);
    }
    addch(boven_rechts);

    mvaddch(y1 - 1, x0, onder_links);
    for (int x = x0 + 1; x < x1 - 1; x++) {
        addch(onder);
    }
    addch(onder_rechts);

    for (int y = y0 + 1; y < y1 - 1; y++) {
        mvaddch(y, x0, links);
        mvaddch(y, x1 - 1, rechts);
    }
}

/* Teken een doos
 *
 * (y0, x0): coördinaten van de linkerbovenhoek
 * (hoogte, breedte): maat van de doos
 * hoek: karakter om de hoeken mee te tekenen
 * (boven, onder, links, rechts): karakters om de zijkanten mee te tekenen
 *
 * Side effect: een doos wordt getekend op het scherm
 */
void doos_enkele_hoek(
    int y0, int x0, int hoogte, int breedte,
    char hoek,
    char boven, char onder, char links, char rechts
) {
    doos(
        y0, x0, hoogte, breedte,
        hoek, hoek, hoek, hoek,
        boven, onder, links, rechts
    );
}


/* Teken een doos
 *
 * (y0, x0): coördinaten van de linkerbovenhoek
 * (hoogte, breedte): maat van de doos
 * hoek: karakter om de hoeken mee te tekenen
 * horizontaal: karakter om de linker- en rechterkant mee te tekenen
 * verticaal: karakter om de boven- en onderkant mee te tekenen
 *
 * Side effect: een doos wordt getekend op het scherm
 */
void doos_symmetrisch(
    int y0, int x0, int hoogte, int breedte,
    char hoek, char horizontaal, char verticaal
) {
    doos_enkele_hoek(
        y0, x0, hoogte, breedte,
        hoek,
        horizontaal, horizontaal, verticaal, verticaal
    );
}

/* Toon een bericht in een venster
 *
 * bericht: het bericht te tonen
 * venster_attr: (kleur) attributen voor het venster
 * tekst_attr: (kleur) attributen voor het bericht
 *
 * Side effect: een bericht wordt getekend in het midden van het scherm
 */
void toon_bericht(const char *bericht, int venster_attr, int tekst_attr) {
    int lengte = strlen(bericht);

    int x0 = COLS / 2 - lengte / 2;
    int x1 = x0 + lengte;

    int y0 = LINES / 2 - 1;

    attron(venster_attr);
    // maak wat ruimte vrij om het venster heen
    doos_symmetrisch(y0 - 3, x0 - 4, 7, lengte + 8, ' ', ' ', ' ');
    doos_symmetrisch(y0 - 3, x0 - 3, 7, lengte + 6, ' ', ' ', ' ');
    // teken het venster zelf
    doos_enkele_hoek(y0 - 2, x0 - 2, 5, lengte + 4, '#', '=', '=', '{', '}');
    attroff(venster_attr);

    attron(tekst_attr);
    for (int y = y0 - 1; y <= y0 + 1; y++) {
        move(y, x0 - 1);
        for (int i = 0; i <= lengte + 1; i++) {
            addch(' ');
        }
    }
    mvprintw(y0, x0, "%s", bericht);
    attroff(tekst_attr);
}

/* Bereken delta waardes van een rotatie
 *
 * rotatie: aantal stappen van 90 graden met de klok mee, [0, 3]
 * dx: de x-delta wordt hiernaar geschreven
 * dy: de y-delta wordt hiernaar geschreven
 *
 * Side effects: dx en dy worden veranderd
 */
void delta_van_rotatie(int rotatie, int *dx, int *dy) {
    switch (rotatie) {
        case 0:
            *dx = 1;
            *dy = 0;
            break;
        case 1:
            *dx = 0;
            *dy = 1;
            break;
        case 2:
            *dx = -1;
            *dy = 0;
            break;
        case 3:
            *dx = 0;
            *dy = -1;
            break;
    }
}

/* Vul het scherm met een karakter in een spiraal
 *
 * c: het karakter
 * attr: (kleur) attributen
 *
 * Side effect: het scherm wordt gevuld met een karakter
 */
void spiraal(char c, int attr) {
    long pauze = 2000000000 / (COLS * LINES); // 2 seconden totaal
    struct timespec pauze_ts = {
        pauze / 1000000000, // hele seconden
        pauze % 1000000000  // extra nanoseconden
    };

    int x0 = 0;
    int x1 = COLS;
    int y0 = 0;
    int y1 = LINES;

    int x = 0;
    int y = 0;
    int rot = 0; // rotatie, [0, 3]

    attron(attr);
    while (1) {
        mvaddch(y, x, c);
        refresh();

        // probeer een stap te zetten, en draai naar rechts als we tegen een 'muur' lopen
        int kans;
        for (kans = 0; kans < 4; kans++) {
            int dx;
            int dy;
            delta_van_rotatie(rot, &dx, &dy);

            x += dx;
            y += dy;

            if (x < x0 || y < y0 || x >= x1 || y >= y1) {
                x -= dx;
                y -= dy;
                rot = (rot + 1) % 4;

                switch (rot) {
                    case 0: x0++; break;
                    case 1: y0++; break;
                    case 2: x1--; break;
                    case 3: y1--; break;
                }
            } else {
                break;
            }
        }

        // we kunnen geen stap meer zetten: het scherm is vol
        if (kans == 4) {
            break;
        }

        nanosleep(&pauze_ts, NULL);
    }
    attroff(attr);
}

/* Toon het winscherm
 */
void scherm_gewonnen(const rooster *rp) {
    wis_scherm();
    toon_bericht("Je hebt gewonnen!", COLOR_PAIR(C_MUUR), COLOR_PAIR(C_WIN));
    refresh();
}

/* Toon het verliesscherm
 */
void scherm_verloren(const rooster *rp) {
    spiraal('X', COLOR_PAIR(C_VAL));
    toon_bericht("Je hebt verloren :(", COLOR_PAIR(C_MUUR), COLOR_PAIR(C_VERLIES));
    refresh();
}

/* Speelt het spel met een gegeven rooster tot de toestand niet langer
   AAN_HET_SPELEN is.
 */
void speel(rooster *rp) {
    rooster_zet_toestand(rp, AAN_HET_SPELEN);
    wis_scherm();
    toon_rooster(rp);
    refresh();

    while (rooster_vraag_toestand(rp) == AAN_HET_SPELEN) {
        int toets = getch();
        switch (toets) {
            case -1: break;
            case 'a': case KEY_LEFT: beweeg(rp, -1, 0); break;
            case 'd': case KEY_RIGHT: beweeg(rp, 1, 0); break;
            case 'w': case KEY_UP: beweeg(rp, 0, -1); break;
            case 's': case KEY_DOWN: beweeg(rp, 0, 1); break;
        }

        wis_scherm();
        toon_rooster(rp);
        refresh();
    }

    switch (rooster_vraag_toestand(rp)) {
        case GEWONNEN:
            scherm_gewonnen(rp);
            break;
        case VERLOREN:
            scherm_verloren(rp);
            break;
        default:
            fprintf(stderr, "Onverwachte toestand");
            exit(1);
            break;
    }
}

int main(int argc, char *argv[]) {
    // 1. Controleer dat er een doolhofbestand is opgegeven op de command line.
    if (argc != 2) {
        fprintf(stderr, "gebruik: ./spel assets/voorbeeld_doolhof.txt\n");
        return 1;
    }

    // 2. Open het doolhofbestand en lees het rooster.
    FILE *fh = fopen(argv[1], "r");
    if (fh == NULL) {
        perror("main");
        return 1;
    }
    rooster *rp = rooster_lees(fh);
    fclose(fh);

    // 3. Bepaal of het lezen van het rooster is gelukt.
    if (rp == NULL) {
        fprintf(stderr, "Kan rooster niet maken.\n");
        return 1;
    }

    // 4. Initialiseer ncurses
    initscr();
    cbreak();             // zodat je kunt onderbreken met Ctrl+C
    keypad(stdscr, TRUE); // luister ook naar extra toetsen zoals pijltjes
    noecho();             // druk niet de letters af die je intypt
    curs_set(0);          // verberg de cursor

    // 5. Initialiseer kleurattributen
    start_color();
    init_pair(C_LEEG, COLOR_BLACK, COLOR_BLACK);
    init_pair(C_MUUR, COLOR_BLUE, COLOR_BLACK);
    init_pair(C_SPELER, COLOR_WHITE, COLOR_BLACK);
    init_pair(C_DOEL, COLOR_BLACK, COLOR_GREEN);
    init_pair(C_VAL, COLOR_BLACK, COLOR_RED);
    init_pair(C_WIN, COLOR_GREEN, COLOR_BLACK);
    init_pair(C_VERLIES, COLOR_RED, COLOR_BLACK);
    init_pair(C_ROOD, COLOR_RED, COLOR_BLACK);
    init_pair(C_GROEN, COLOR_GREEN, COLOR_BLACK);

    // 6. Speel het spel.
    speel(rp);

    // 7. Sluit af.
    getch(); // Optioneel, om te zorgen dat het spel niet meteen stopt.
    rooster_klaar(rp);
    endwin();
    return 0;
}
